{
  "name": "civicvoice-aws",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts lambda.ts --bundle --platform=node --format=esm --packages=external --outdir=dist/server",
    "start": "node dist/server/server.js",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build:lambda": "esbuild lambda.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/lambda.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.888.0",
    "@aws-sdk/client-cloudwatch": "^3.1136.0",
    "@aws-sdk/client-dynamodb": "^3.888.0",
    "@aws-sdk/client-eventbridge": "^3.1136.0",
    "@aws-sdk/client-s3": "^3.888.0",
    "@aws-sdk/client-transcribe": "^3.888.0",
    "@aws-sdk/lib-dynamodb": "^3.888.0",
    "@aws-sdk/s3-request-presigner": "^3.888.0",
    "@codegenie/serverless-express": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.2",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
