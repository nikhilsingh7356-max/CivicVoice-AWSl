AWS_REGION=ap-south-1
CASES_TABLE=CivicVoiceCases
CASE_HISTORY_TABLE=CivicVoiceCaseHistory
MEDIA_BUCKET=civicvoice-evidence-CHANGE-ME
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0
EVENT_BUS_NAME=CivicVoiceEventBus
# Set to true to disable CloudWatch custom metric emission (used in automated tests).
DISABLE_CLOUDWATCH_METRICS=false
PORT=3000

# --- Public Cognito config (Cognito Hosted UI + PKCE) -------------------------
# These values are PUBLIC (embedded in the SPA) — never put secrets here.
# See aws-resources.yaml (Cognito resources) for the exact values to use.
#
# VITE_COGNITO_USER_POOL_ID=<pool id, e.g. ap-south-1_AbCdEf12>
# VITE_COGNITO_CLIENT_ID=<app client id>
# VITE_COGNITO_DOMAIN=https://civicvoice-auth.auth.ap-south-1.amazoncognito.com
# VITE_COGNITO_REDIRECT_URI=http://localhost:3000

# --- API Gateway base URL (Amplify environment variable) ----------------------
# NOT a Cognito setting. Set this in the Amplify console environment variables
# for the frontend build, not in the Cognito user pool/app client.
# The SPA prefixes all API requests with this base via src/lib/api.ts (apiUrl()).
# Local development: leave unset to keep the existing same-origin /api/... proxy
# behavior. Production: if unset, apiUrl() throws a clear error instead of
# hitting the Amplify SPA origin with HTML responses.
VITE_API_BASE_URL=https://w2o3ktyph9.execute-api.ap-south-1.amazonaws.com/Prod
